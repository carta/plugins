{
  "limits": {
    "max_payload_bytes": 262144,
    "max_nodes": 5000,
    "max_facts_per_node": 1000,
    "max_key_length": 128,
    "max_label_length": 500,
    "max_comment_length": 2000,
    "max_depth": 20,
    "max_value_aliases": 1000,
    "max_name_length": 255,
    "max_source_client_length": 64,
    "max_source_version_length": 32
  },
  "node_kinds": ["line", "section_header", "subsection_header", "subtotal", "summary", "total"],
  "view_kinds": ["by-account", "by-line-item", "by-tag-crosstab"],
  "granularities": ["monthly", "quarterly"],
  "period_kinds": ["annual", "ytd_through_as_of"],
  "derived_rules": ["net_income", "expression"],
  "payload_keys": {
    "required": ["period_year", "period_granularity", "currency", "native_view_kind", "budget"],
    "optional": ["period_kind", "value_aliases"]
  },
  "budget_keys": ["dimensions", "nodes"],
  "node_keys": {
    "required": ["key", "kind", "label", "depth", "order", "gl_codes", "facts"],
    "optional": ["section", "constituents", "comments", "derived"]
  },
  "fact_keys": ["period", "scope", "amount"],
  "scope_keys": ["value"],
  "snapshot_basis_keys": {
    "required": ["as_of"],
    "optional": ["fetched_at"]
  },
  "source_keys": {
    "required": ["client"],
    "optional": ["client_version"]
  }
}
